#!/usr/bin/env python3
"""Decide CLOSE / RFI / ESCALATE for every case in an institution folder."""

from __future__ import annotations

import json
import os
import sys
import time


def main(argv: list[str]) -> int:
    if len(argv) != 3:
        print(
            "Usage: system/run <institution_folder> <output_file>",
            file=sys.stderr,
        )
        return 2

    institution_folder = os.path.abspath(argv[1])
    output_file = os.path.abspath(argv[2])

    here = os.path.dirname(os.path.abspath(__file__))
    if here not in sys.path:
        sys.path.insert(0, here)

    from decide import decide_case
    from loader import InstitutionData

    if not os.path.isdir(institution_folder):
        print(f"Institution folder not found: {institution_folder}", file=sys.stderr)
        return 1

    started = time.time()
    data = InstitutionData(institution_folder)
    out_dir = os.path.dirname(output_file)
    if out_dir:
        os.makedirs(out_dir, exist_ok=True)

    # Stable order: as in cases.jsonl
    results = []
    for case in data.cases:
        bundle = data.assemble_case(case)
        results.append(decide_case(bundle))

    with open(output_file, "w", encoding="utf-8") as f:
        for row in results:
            f.write(json.dumps(row, ensure_ascii=False, separators=(",", ": ")))
            f.write("\n")

    elapsed = time.time() - started
    print(
        f"Wrote {len(results)} cases to {output_file} in {elapsed:.1f}s "
        f"({data.institution})",
        file=sys.stderr,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
